    {
      "cell_type": "code",
      "source": [
        "df = pd.read_csv(\"student-mat.csv\")\n",
        "\n",
        "df_enc = df.copy()\n",
        "le = LabelEncoder()\n",
        "for c in df_enc.select_dtypes(include=\"object\").columns:\n",
        "    df_enc[c] = le.fit_transform(df_enc[c])\n",
        "\n",
        "num_cols = [\"age\",\"Medu\",\"Fedu\",\"traveltime\",\"studytime\",\"failures\",\n",
        "            \"famrel\",\"freetime\",\"goout\",\"Dalc\",\"Walc\",\"health\",\"absences\",\"G1\",\"G2\",\"G3\"]\n",
        "\n",
        "scaler   = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(df_enc[num_cols].values)\n",
        "\n",
        "df_enc[\"pass\"] = (df_enc[\"G3\"] >= 10).astype(int)\n",
        "y_clf = df_enc[\"pass\"].values\n",
        "y_reg = df_enc[\"G3\"].values\n",
        "\n",
        "PASS_COLORS = {0: \"#e74c3c\", 1: \"#2ecc71\"}\n",
        "PASS_LABELS = {0: \"Fail\", 1: \"Pass\"}\n",
        "\n",
        "pca2 = PCA(n_components=2)\n",
        "Xp2  = pca2.fit_transform(X_scaled)\n",
        "\n",
        "km3 = KMeans(n_clusters=3, random_state=42, n_init=10)\n",
        "km3.fit(X_scaled)\n",
        "df_enc[\"cluster\"] = km3.labels_\n",
        "palette3 = [\"#e74c3c\",\"#3498db\",\"#2ecc71\"]\n",
        "\n",
        "X_tr, X_te, y_tr, y_te = train_test_split(X_scaled, y_clf, test_size=0.2, random_state=42)\n",
        "X_tr_r, X_te_r, y_tr_r, y_te_r = train_test_split(X_scaled, y_reg, test_size=0.2, random_state=42)\n",
        "\n",
        "rf_te = RandomForestClassifier(n_estimators=100, random_state=42)\n",
        "rf_te.fit(X_tr, y_tr)\n",
        "\n",
        "print(\"Setup complete ✔\")"
      ],
