        "import plotly.graph_objects as go\n",
        "import numpy as np\n",
        "pivot = df_enc.groupby([\"Medu\",\"Fedu\"])[\"G3\"].mean().unstack(fill_value=np.nan)\n",
        "Xm = pivot.columns.values.astype(float)\n",
        "Ym = pivot.index.values.astype(float)\n",
        "Xmm, Ymm = np.meshgrid(Xm, Ym)\n",
        "zm = np.where(np.isnan(pivot.values),np.nanmean(pivot.values),pivot.values)\n",
        "fig = go.Figure(data=[go.Surface(z=Zm,x=Xmm,y=Ymm,colorscale='Viridis',hovertemplate='Father Edu: %{x}<br>' +'Mother Edu: %{y}<br>' +'Mean G3: %{z}<extra></extra>')])\n",
